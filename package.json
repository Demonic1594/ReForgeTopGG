{
  "name": "@tryforge/reforge.topgg",
  "version": "3.1.0",
  "description": "ReForgeTopGG: a hardened Top.gg extension for ForgeScript. Posts bot stats and receives votes safely (required secret, signed v1 webhooks, de-duplicated retries), with vote history, streaks and reminders. Fork of tryforge/ForgeTopGG.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "lint": "tsc --noEmit -p . --noUnusedLocals --noImplicitReturns --noFallthroughCasesInSwitch",
    "test": "tsc && node --test test/*.test.js",
    "docgen": "tsc && node dist/docgen"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Demonic1594/ReForgeTopGG.git"
  },
  "keywords": [
    "discord",
    "extension",
    "forge",
    "forgescript",
    "topgg",
    "top.gg",
    "votes",
    "webhook",
    "reforge",
    "reforgetopgg"
  ],
  "author": "ruben40000 (original), Demonic1594 (fork)",
  "license": "GPL-3.0",
  "dependencies": {
    "@top-gg/sdk": "^3.1.6",
    "tiny-typed-emitter": "^2.1.0",
    "topgg-autoposter": "^2.0.2"
  },
  "devDependencies": {
    "@tryforge/forge.db": "^2.1.1",
    "@tryforge/forgescript": "^2.8.0",
    "@tryforge/reforge.db": "github:Demonic1594/ReForgeDB#v3.1.0",
    "@types/node": "^22.20.5",
    "better-sqlite3": "^12.11.1",
    "discord.js": "^14.28.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@tryforge/forgescript": ">=2.5.0",
    "@tryforge/reforge.db": "^3.0.0",
    "@tryforge/forge.db": "^2.1.0"
  },
  "peerDependenciesMeta": {
    "@tryforge/reforge.db": {
      "optional": true
    },
    "@tryforge/forge.db": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "metadata",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "bugs": {
    "url": "https://github.com/Demonic1594/ReForgeTopGG/issues"
  },
  "homepage": "https://github.com/Demonic1594/ReForgeTopGG#readme"
}
